{
  "name": "dsh-decision-review",
  "version": "0.1.0",
  "description": "Independent decision review for DeepSeek Harness: the primary model keeps deciding, a reviewer model only advises.",
  "type": "module",
  "main": "./src/decision-model.mjs",
  "exports": {
    ".": "./src/decision-model.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README_EN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "plugin",
    "decision",
    "review"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node --check src/decision-core.mjs && node --check src/decision-model.mjs",
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
